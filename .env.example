# Next.js / Supabase — copy to .env and fill in real values.
# Never commit the real .env.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production push webhook: the absolute URL of this app's /api/push/send
# endpoint that Supabase web-push triggers call (e.g.
# https://your-app.example.com/api/push/send). When left unset, the value from
# the Supabase `settings.push_webhook_url` row is used (its local/dev default is
# http://host.docker.internal:3000/api/push/send). For production you MUST set
# this so the Supabase-to-app push webhook can reach your deployed instance.
# PUSH_WEBHOOK_URL=

# Initial admin bootstrap (used by POST /api/setup/initial-admin)
INITIAL_ADMIN_EMAIL=admin@wajebaty.local
INITIAL_ADMIN_PASSWORD=replace_with_strong_password
INITIAL_ADMIN_FULL_NAME=مدير واجباتي
INITIAL_ADMIN_CODE=admin01
INITIAL_SETUP_SECRET=replace_with_random_secret

# Edge function guard (server-side only)
CLEANUP_SECRET=replace_with_random_secret